# secrets
.env

# data and caches (too big for Git)
data/raw/*
data/interim/*
data/processed/*
cache/*
!**/.gitkeep

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# dashboard data built from the gold set (regenerate with src/make_dashboard_data.py)
dashboard_kaggle/

# teammate repo (has its own git) and local envs
taxonomy-skill-project/
.venv/

# posting text is shared via Google Drive, not Git
data/gold/gold_postings.csv
data/gold/gold_postings_dev.csv
data/gold/gold_postings_test.csv

# never commit: screenshots with credentials, local Claude Code state
Supabase.png
.claude/

# downloads that scripts recreate, copyrighted papers, run logs
data/reference/
data/gold/reference/*.pdf
reports/*.log

# hand-off bundles for teammates (contain posting text): share via Drive, never Git
exports/

# macOS folder metadata
.DS_Store

# Google Drive folder icons (Drive for desktop)
desktop.ini

# Blind reviews: answer keys and reviewer responses never go to Git (a teammate could read them before
# answering). Keys stay on the machine that built them; responses are handed in once everyone has submitted.
# Intrusion v2 key: data/interim/intrusion_v2/ (already ignored by data/interim/*).
data/validation/manifests/*_key.json
data/validation/reviews/*/*
!data/validation/reviews/*/.gitkeep
reports/intrusion_v2/*/responses/
reports/intrusion_v2/*/submitted/
